<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.github.theholywaffle</groupId>
	<artifactId>teamspeak3-api</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>TeamSpeak 3 Java API</name>
	<url>https://github.com/TheHolyWaffle/TeamSpeak-3-Java-API</url>
	<description>A Java wrapper of the TeamSpeak 3 Server Query API</description>

	<licenses>
		<license>
			<name>MIT</name>
			<url>http://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<email>degeyter.bert@gmail.com</email>
			<name>Bert De geyter</name>
			<url>https://github.com/TheHolyWaffle</url>
			<id>TheHolyWaffle</id>
		</developer>
		<developer>
			<email>rogermarcbaumgartner@hotmail.com</email>
			<name>Roger Baumgartner</name>
			<url>https://github.com/rogermb</url>
			<id>rogermb</id>
			<timezone>+1</timezone>
		</developer>
	</developers>

	<scm>
		<url>scm:git:git@github.com:TheHolyWaffle/TeamSpeak-3-Java-API.git</url>
		<connection>scm:git:git@github.com:TheHolyWaffle/TeamSpeak-3-Java-API.git</connection>
		<developerConnection>scm:git:git@github.com:TheHolyWaffle/TeamSpeak-3-Java-API.git</developerConnection>
	</scm>

	<issueManagement>
		<url>https://github.com/TheHolyWaffle/TeamSpeak-3-Java-API/issues</url>
		<system>GitHub Issues</system>
	</issueManagement>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<sshj.version>0.41.1</sshj.version>
		<slf4j.version>2.0.20</slf4j.version>
		<gson.version>2.14.0</gson.version>
		<bouncycastle.version>1.86</bouncycastle.version>
		<junit.version>6.1.3</junit.version>
		<testcontainers.version>2.0.5</testcontainers.version>
		<errorprone.version>2.50.0</errorprone.version>
		<palantir-java-format.version>2.102.0</palantir-java-format.version>
		<!-- Summaries are optional: many members are fully described by @return or @see. -->
		<errorprone.flags>-XepDisableWarningsInGeneratedCode -Xep:MissingSummary:OFF</errorprone.flags>
		<jreleaser.config.file>${project.basedir}/jreleaser.yml</jreleaser.config.file>
		<project.build.outputTimestamp>1980-01-01T00:00:02Z</project.build.outputTimestamp>
		<!-- API compatibility baseline: the latest published release, verified by checksum. Same groupId,
		     artifactId, packages and Automatic-Module-Name as this build. -->
		<api.baseline.version>1.3.1</api.baseline.version>
		<api.baseline.sha256>e76bfdb446c5d814a23ddd4f5f49486c1361fa61bcb2c8f393c7c13d96794756</api.baseline.sha256>
		<api.baseline.jar>${project.build.directory}/api-baseline/${project.artifactId}-${api.baseline.version}.jar</api.baseline.jar>
		<!-- By default the pending version must cover the change since the baseline; japicmp reads each
		     version from the file name. .github/scripts/api-compare.sh sets an explicit release impact. -->
		<api.compare.old>${api.baseline.jar}</api.compare.old>
		<api.compare.new>${project.build.directory}/${project.build.finalName}.jar</api.compare.new>
		<api.checkVersions>true</api.checkVersions>
		<api.rejectIncompatible>false</api.rejectIncompatible>
		<api.rejectAnyChange>false</api.rejectAnyChange>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- SSHJ 0.41.1 uses BC 1.84, affected by CVE-2026-8763 and CVE-2026-13506.
			     Keep provider, PKIX and utility modules aligned using the upstream BOM. -->
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bc-jdk18on-bom</artifactId>
				<version>${bouncycastle.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>com.hierynomus</groupId>
			<artifactId>sshj</artifactId>
			<version>${sshj.version}</version>
		</dependency>
		<!-- Declare the patched crypto modules directly: this project's dependency
		     management alone does not override SSHJ's transitives for consumers. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcpkix-jdk18on</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>
		<!-- JSON for the Web Query transport. -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>${gson.version}</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>${slf4j.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Invoked by prefix from release scripts and workflows. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-help-plugin</artifactId>
					<version>3.5.2</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>versions-maven-plugin</artifactId>
					<version>2.22.0</version>
				</plugin>
				<!-- Forks a JVM on the test classpath for the dev-server and example profiles. -->
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>3.6.4</version>
					<configuration>
						<executable>${java.home}/bin/java</executable>
						<classpathScope>test</classpathScope>
						<inheritIo>true</inheritIo>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.3</version>
				<executions>
					<execution>
						<id>enforce-build-environment</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[25,)</version>
									<message>Build with JDK 25 or newer. Set JAVA_HOME to a supported JDK installation and run ./mvnw -B -ntp verify.</message>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.10.0,4)</version>
									<message>Build with the pinned Maven distribution using ./mvnw (mvnw.cmd on Windows).</message>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>verify-api-baseline</id>
						<phase>package</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireFileChecksum>
									<file>${api.baseline.jar}</file>
									<checksum>${api.baseline.sha256}</checksum>
									<type>sha256</type>
									<message>The API baseline ${api.baseline.jar} does not match the verified published artifact.</message>
								</requireFileChecksum>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-artifact-plugin</artifactId>
				<version>3.7.0</version>
				<executions>
					<execution>
						<!-- Rejects plugins known to break reproducible output and a missing outputTimestamp. -->
						<id>check-reproducible-build-plan</id>
						<phase>validate</phase>
						<goals>
							<goal>check-buildplan</goal>
						</goals>
						<configuration>
							<failOnNonReproducible>true</failOnNonReproducible>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.10.3</version>
				<configuration>
					<java>
						<includes>
							<include>src/main/java/**/*.java</include>
							<include>src/test/java/**/*.java</include>
							<include>src/example/java/**/*.java</include>
							<include>src/test/api-fixtures/**/*.java</include>
							<include>src/test/consumers/**/*.java</include>
						</includes>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
						</palantirJavaFormat>
					</java>
					<formats>
						<format>
							<includes>
								<include>.github/**/*.yml</include>
								<include>.github/**/*.sh</include>
								<include>src/**/*.properties</include>
								<include>src/**/*.sh</include>
								<include>*.yml</include>
								<include>*.json</include>
								<include>pom.xml</include>
								<include>src/test/consumers/**/*.xml</include>
								<include>src/test/consumers/**/*.kts</include>
							</includes>
							<trimTrailingWhitespace />
							<endWithNewline />
						</format>
					</formats>
				</configuration>
				<!-- Spotless resolves the formatter itself; this declaration lets Dependabot update the version. -->
				<dependencies>
					<dependency>
						<groupId>com.palantir.javaformat</groupId>
						<artifactId>palantir-java-format</artifactId>
						<version>${palantir-java-format.version}</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>check-formatting</id>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Compiles the examples with the tests, so every build catches API drift; they are never packaged. -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>add-example-sources</id>
						<phase>generate-test-sources</phase>
						<goals>
							<goal>add-test-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>src/example/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.5.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.5.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>3.2.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>3.2.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<showWarnings>true</showWarnings>
					<failOnWarning>true</failOnWarning>
					<annotationProcessorPaths>
						<path>
							<groupId>com.google.errorprone</groupId>
							<artifactId>error_prone_core</artifactId>
							<version>${errorprone.version}</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs>
						<arg>-Xlint:all</arg>
						<arg>-Xmaxwarns</arg>
						<arg>10000</arg>
						<arg>-XDcompilePolicy=simple</arg>
						<arg>--should-stop=ifError=FLOW</arg>
					</compilerArgs>
				</configuration>
				<executions>
					<execution>
						<id>default-compile</id>
						<configuration>
							<compilerArgs combine.children="append">
								<arg>-Xdoclint:all/protected</arg>
								<arg>-Xdoclint:-missing</arg>
								<arg>-Xplugin:ErrorProne ${errorprone.flags}</arg>
							</compilerArgs>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<configuration>
							<!-- Test fixtures close servers whose close() may be interrupted, and tests start
							     futures only to observe their side effects. -->
							<compilerArgs combine.children="append">
								<arg>-Xlint:-try</arg>
								<arg>-Xplugin:ErrorProne ${errorprone.flags} -Xep:FutureReturnValueIgnored:OFF</arg>
							</compilerArgs>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>com.github.theholywaffle.teamspeak3</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<excludedGroups>debug-logging</excludedGroups>
				</configuration>
				<executions>
					<execution>
						<!-- A separate JVM, so slf4j-simple starts with DEBUG output to a file. -->
						<id>debug-communication-logging</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<groups>debug-logging</groups>
							<excludedGroups combine.self="override" />
							<reportsDirectory>${project.build.directory}/surefire-reports/debug-logging</reportsDirectory>
							<systemPropertyVariables>
								<org.slf4j.simpleLogger.defaultLogLevel>debug</org.slf4j.simpleLogger.defaultLogLevel>
								<org.slf4j.simpleLogger.logFile>${project.build.directory}/debug-communication.log</org.slf4j.simpleLogger.logFile>
							</systemPropertyVariables>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check-critical-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<!-- Per-class floors for protocol, lifecycle and error-path code; facades and models are
							     covered by the TS3 integration suite instead of a global percentage. -->
							<rules>
								<rule>
									<element>CLASS</element>
									<includes>
										<include>com.github.theholywaffle.teamspeak3.CommandQueue*</include>
										<include>com.github.theholywaffle.teamspeak3.Connection</include>
										<include>com.github.theholywaffle.teamspeak3.Deadline</include>
										<include>com.github.theholywaffle.teamspeak3.KeepAlive</include>
										<include>com.github.theholywaffle.teamspeak3.ProtocolLineReader</include>
										<include>com.github.theholywaffle.teamspeak3.StreamReader</include>
										<include>com.github.theholywaffle.teamspeak3.StreamWriter</include>
										<include>com.github.theholywaffle.teamspeak3.TS3Query</include>
										<include>com.github.theholywaffle.teamspeak3.EventManager*</include>
										<include>com.github.theholywaffle.teamspeak3.FileTransferHelper*</include>
										<include>com.github.theholywaffle.teamspeak3.QueryConfig</include>
										<include>com.github.theholywaffle.teamspeak3.SshHostKeyPolicy*</include>
										<include>com.github.theholywaffle.teamspeak3.TS3WebQuery</include>
										<include>com.github.theholywaffle.teamspeak3.WebQuery*</include>
										<include>com.github.theholywaffle.teamspeak3.ServerQueryBackend</include>
										<include>com.github.theholywaffle.teamspeak3.api.exception.TS3AuthenticationFailedException</include>
										<include>com.github.theholywaffle.teamspeak3.api.exception.TS3HttpException</include>
										<include>com.github.theholywaffle.teamspeak3.api.CommandFutures*</include>
										<include>com.github.theholywaffle.teamspeak3.api.exception.TS3CommandFailedException</include>
										<include>com.github.theholywaffle.teamspeak3.api.exception.TS3TimeoutException</include>
										<include>com.github.theholywaffle.teamspeak3.api.exception.TS3InvalidValueException</include>
										<include>com.github.theholywaffle.teamspeak3.api.reconnect.*</include>
										<include>com.github.theholywaffle.teamspeak3.api.wrapper.QueryError</include>
										<include>com.github.theholywaffle.teamspeak3.commands.Command</include>
										<include>com.github.theholywaffle.teamspeak3.commands.CommandBuilder</include>
										<include>com.github.theholywaffle.teamspeak3.commands.CommandEncoding</include>
										<include>com.github.theholywaffle.teamspeak3.commands.ProtocolRedactor</include>
										<include>com.github.theholywaffle.teamspeak3.commands.parameter.*</include>
										<include>com.github.theholywaffle.teamspeak3.commands.response.*</include>
									</includes>
									<excludes>
										<exclude>com.github.theholywaffle.teamspeak3.api.CommandFutures.RequestFuture</exclude>
										<exclude>com.github.theholywaffle.teamspeak3.api.reconnect.ReconnectingConnectionHandler</exclude>
										<exclude>com.github.theholywaffle.teamspeak3.api.reconnect.ReconnectStrategy.UserControlled</exclude>
										<exclude>com.github.theholywaffle.teamspeak3.api.reconnect.SessionConfiguration.Subscription</exclude>
									</excludes>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.75</minimum>
										</limit>
									</limits>
								</rule>
								<rule>
									<!-- Remaining branches are concurrent state races, exercised by the integration suite. -->
									<element>CLASS</element>
									<includes>
										<include>com.github.theholywaffle.teamspeak3.api.CommandFutures.RequestFuture</include>
										<include>com.github.theholywaffle.teamspeak3.api.reconnect.ReconnectingConnectionHandler</include>
										<include>com.github.theholywaffle.teamspeak3.api.reconnect.ReconnectStrategy.UserControlled</include>
										<include>com.github.theholywaffle.teamspeak3.api.reconnect.SessionConfiguration.Subscription</include>
									</includes>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.50</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<release>${maven.compiler.release}</release>
					<quiet>true</quiet>
					<show>protected</show>
					<!-- Same policy as the compiler's -Xdoclint. -->
					<doclint>all,-missing</doclint>
					<failOnWarnings>true</failOnWarnings>
					<linksource>true</linksource>
					<notimestamp>true</notimestamp>
					<bottom>Released under the MIT license.</bottom>
					<tags>
						<tag>
							<name>querycommands</name>
							<placement>m</placement>
							<head>Number of query commands sent:</head>
						</tag>
					</tags>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.11.0</version>
				<executions>
					<execution>
						<id>fetch-api-baseline</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>${project.groupId}</groupId>
									<artifactId>${project.artifactId}</artifactId>
									<version>${api.baseline.version}</version>
								</artifactItem>
							</artifactItems>
							<outputDirectory>${project.build.directory}/api-baseline</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.github.siom79.japicmp</groupId>
				<artifactId>japicmp-maven-plugin</artifactId>
				<version>0.26.2</version>
				<executions>
					<execution>
						<!-- Public and protected API of every package; no exclusions. -->
						<id>api-compatibility</id>
						<phase>verify</phase>
						<goals>
							<goal>cmp</goal>
						</goals>
						<configuration>
							<oldVersion>
								<file>
									<path>${api.compare.old}</path>
								</file>
							</oldVersion>
							<newVersion>
								<file>
									<path>${api.compare.new}</path>
								</file>
							</newVersion>
							<parameter>
								<accessModifier>protected</accessModifier>
								<onlyModified>true</onlyModified>
								<reportOnlyFilename>true</reportOnlyFilename>
								<breakBuildBasedOnSemanticVersioning>${api.checkVersions}</breakBuildBasedOnSemanticVersioning>
								<breakBuildOnBinaryIncompatibleModifications>${api.rejectIncompatible}</breakBuildOnBinaryIncompatibleModifications>
								<breakBuildOnSourceIncompatibleModifications>${api.rejectIncompatible}</breakBuildOnSourceIncompatibleModifications>
								<breakBuildOnModifications>${api.rejectAnyChange}</breakBuildOnModifications>
								<markdownTitle>API compatibility</markdownTitle>
							</parameter>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jreleaser</groupId>
				<artifactId>jreleaser-maven-plugin</artifactId>
				<version>1.26.0</version>
				<inherited>false</inherited>
				<configuration>
					<configFile>${jreleaser.config.file}</configFile>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Packages the library for API comparisons only: no tests, coverage, formatting or attachments. -->
		<profile>
			<id>api-quick</id>
			<properties>
				<maven.test.skip>true</maven.test.skip>
				<jacoco.skip>true</jacoco.skip>
				<spotless.check.skip>true</spotless.check.skip>
				<maven.javadoc.skip>true</maven.javadoc.skip>
				<maven.source.skip>true</maven.source.skip>
			</properties>
		</profile>
		<!-- The formatter parses with the running javac, and no release supports JDK 26+ internals yet.
		     Formatting does not depend on the build JDK, so JDK 25 builds and CI enforce it. -->
		<profile>
			<id>format-check-on-baseline-jdk-only</id>
			<activation>
				<jdk>[26,)</jdk>
			</activation>
			<properties>
				<spotless.check.skip>true</spotless.check.skip>
			</properties>
		</profile>
		<!-- Fork a development-only JVM using the already test-scoped harness. -->
		<profile>
			<id>dev-server</id>
			<properties>
				<dev.server>ts3</dev.server>
				<dev.once>false</dev.once>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<arguments>
								<argument>-classpath</argument>
								<classpath />
								<argument>com.github.theholywaffle.teamspeak3.DevelopmentServer</argument>
								<argument>${dev.server}</argument>
								<argument>${dev.once}</argument>
							</arguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Runs one compiled example in a forked JVM; connection settings come from TS3_* environment variables. -->
		<profile>
			<id>example</id>
			<properties>
				<example>ClientInfoExample</example>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<arguments>
								<!-- SSHJ logs connection details at INFO and a harmless warning when the server closes the channel. -->
								<argument>-Dorg.slf4j.simpleLogger.log.net.schmizz=error</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>com.github.theholywaffle.teamspeak3.example.${example}</argument>
							</arguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>integration</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.6.0</version>
						<configuration>
							<failIfNoTests>true</failIfNoTests>
							<forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
						</configuration>
						<executions>
							<execution>
								<goals><goal>integration-test</goal><goal>verify</goal></goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>prepare-agent-integration</id>
								<goals>
									<goal>prepare-agent-integration</goal>
								</goals>
							</execution>
							<execution>
								<id>report-integration</id>
								<goals>
									<goal>report-integration</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>central-staging</id>
			<properties>
				<altDeploymentRepository>local-staging::file://${project.build.directory}/staging-deploy</altDeploymentRepository>
			</properties>
		</profile>
	</profiles>

</project>
