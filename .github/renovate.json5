// Version updates for everything the build pins.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':semanticCommits', ':automergeMinor', ':automergeDigest'],
  // config:recommended skips test directories; the TS3 image lives under src/test.
  ignorePaths: [],
  // Broken or withdrawn releases are usually caught upstream within a week.
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      // Only the published library's runtime dependencies ship in a release (fix(deps):); build tools,
      // test dependencies and wrappers are chores.
      matchManagers: ['gradle', 'gradle-wrapper'],
      semanticCommitType: 'chore',
    },
    {
      matchManagers: ['gradle'],
      matchPackageNames: ['com.hierynomus:sshj', 'org.slf4j:slf4j-api', 'com.google.code.gson:gson', 'org.bouncycastle:**'],
      semanticCommitType: 'fix',
    },
    {
      // Major updates of test dependencies and build tools merge too; others need review.
      matchManagers: ['gradle'],
      matchPackageNames: [
        'org.junit:**',
        'org.testcontainers:**',
        'org.slf4j:slf4j-simple',
        'com.google.errorprone:**',
        'com.palantir.javaformat:**',
        'org.jacoco:**',
        'org.jreleaser:**',
        'net.ltgt.errorprone{,.gradle.plugin}',
        'com.diffplug.spotless{,.gradle.plugin}',
      ],
      automerge: true,
    },
  ],
}
